#!/bin/sh
# Validate configuration through the repository-local .venv.
#
# Usage:
#   ./scripts/validate
#   ./scripts/validate --config config/default.yaml
set -e
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [ ! -d "$REPO_ROOT/.venv" ]; then
  printf "Error: repository-local .venv not found at %s\n" "$REPO_ROOT/.venv" >&2
  printf "Run: uv sync --group dev\n" >&2
  exit 1
fi
exec "$REPO_ROOT/.venv/bin/python" -m argusprowl validate-config "$@"
