# Environment files and secrets
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.pfx

# Python caches and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.venv/
venv/

# Local databases and runtime state
*.db
*.sqlite
*.sqlite3
*.duckdb
/data/
/store/
/metadata/
/metadata_dropped/
/preprocessed_configs/
/clickhouse/
/vector/

# Logs
*.log
/logs/*
!logs/.gitkeep
/scripts/logs/*
!scripts/logs/.gitkeep
/frontend/logs/*
!frontend/logs/.gitkeep

# Local run and temporary output
/runs/*
!runs/.gitkeep
/tmp/*
!tmp/.gitkeep

# Captures and model artifacts
*.pcap
*.pcapng
*.joblib
*.pkl
data/*
!data/.gitkeep
models/*
!models/.gitkeep

# Frontend dependencies, caches, and build output
frontend/node_modules/
frontend/dist/
**/.vite/
frontend/.vite/
node_modules/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
.obsidian/
