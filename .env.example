# Product container: API binding (docker-compose.yml sets these on the
# container; kept here as reference for local/advanced setups).
TH_API__HOST=0.0.0.0
TH_API__PORT=8080

# Research/dev-only (Zeek/ClickHouse/Vector stack — not part of the product):
SENSOR_NAME=argus-sensor-docker
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=argusprowl
ZEEK_INTERFACE=wlan0
